@model List<firstASP.Models.Product>

@{ ViewData["Title"] = "Products"; }


<h1>Products</h1>

<form asp-action="Index" method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="searchString" value="@ViewData["searchString"]"
           placeholder="Search product name..." class="form-control w-25" />
    <button type="submit" class="btn btn-secondary">Search</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
</form>

<a asp-action="Create" class="btn btn-primary mb-3">+ Add Product</a>


<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Unit Measure</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Description</td>
                <td>@p.UnitMeasure</td>
                <td>@p.Price</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Delete this product?')">Delete</a>
                </td>
            </tr>
        }

    </tbody>

</table>